[Unit]
Description=Dedicated private address for the Executor pilot
After=network.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ip address replace 10.255.44.1/32 dev lo
ExecStop=/usr/sbin/ip address del 10.255.44.1/32 dev lo

[Install]
WantedBy=multi-user.target
